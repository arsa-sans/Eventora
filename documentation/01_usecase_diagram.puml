@startuml Eventora_Use_Case_Diagram
skinparam usecase {
  BackgroundColor #ECFDF5
  BorderColor #059669
  FontColor #1E293B
  StereotypeFontColor #047857
}
skinparam actor {
  BackgroundColor #ECFDF5
  BorderColor #059669
  FontColor #1E293B
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #059669
  FontColor #1E293B
  RoundCorner 15
}
skinparam ArrowColor #047857
skinparam defaultFontName Inter

left to right direction

' ============================================================
'  DEFINISI AKTOR
' ============================================================
actor "Pengunjung" as Visitor
actor "Pengguna\nTerdaftar" as User
actor "Tamu\nUndangan" as Guest
actor "Mayar\nPayment Gateway" as Mayar <<External System>>

Visitor <|-- User

' ============================================================
'  SYSTEM BOUNDARY — EVENTORA PLATFORM
' ============================================================
rectangle "Sistem Eventora" {

  ' --- Halaman Publik ---
  package "Halaman Publik" <<Rectangle>> {
    usecase "UC01: Melihat\nLanding Page" as UC01
    usecase "UC02: Melihat\nKatalog Tema" as UC02
    usecase "UC03: Preview Tema" as UC03
    usecase "UC04: Melihat\nHalaman Tutorial" as UC04
  }

  ' --- Autentikasi ---
  package "Autentikasi" <<Rectangle>> {
    usecase "UC05: Registrasi\nAkun Baru" as UC05
    usecase "UC06: Login" as UC06
    usecase "UC07: Autentikasi\nGoogle OAuth" as UC07
    usecase "UC08: Verifikasi\nEmail" as UC08
    usecase "UC09: Logout" as UC09
  }

  ' --- Manajemen Undangan ---
  package "Manajemen Undangan" <<Rectangle>> {
    usecase "UC10: Melihat\nDashboard" as UC10
    usecase "UC11: Membuat\nUndangan Baru" as UC11
    usecase "UC12: Mengedit\nUndangan" as UC12
    usecase "UC13: Menghapus\nUndangan" as UC13
    usecase "UC14: Upload Foto\nGaleri/Prewedding" as UC14
    usecase "UC15: Menyalin Link\nUndangan" as UC15
  }

  ' --- Pembayaran & Aktivasi ---
  package "Pembayaran & Aktivasi" <<Rectangle>> {
    usecase "UC16: Mengaktifkan\nUndangan" as UC16
    usecase "UC17: Membuat\nInvoice Pembayaran" as UC17
    usecase "UC18: Memproses\nPembayaran" as UC18
    usecase "UC19: Menerima\nWebhook Notifikasi" as UC19
    usecase "UC20: Aktivasi\nOtomatis Undangan" as UC20
  }

  ' --- Data & Profil ---
  package "Data & Profil" <<Rectangle>> {
    usecase "UC21: Melihat\nData RSVP" as UC21
    usecase "UC22: Mengelola\nPengaturan Profil" as UC22
  }

  ' --- Undangan Publik (Tamu) ---
  package "Undangan Publik" <<Rectangle>> {
    usecase "UC23: Melihat\nUndangan Aktif" as UC23
    usecase "UC24: Mengirim\nRSVP & Ucapan" as UC24
    usecase "UC25: Menyalin\nRekening Hadiah" as UC25
    usecase "UC26: Membuka\nGoogle Maps Lokasi" as UC26
    usecase "UC27: Simpan ke\nGoogle Calendar" as UC27
  }

  ' ============================================================
  '  RELASI INCLUDE & EXTEND
  ' ============================================================

  ' Autentikasi
  UC05 ..> UC08 : <<include>>
  UC05 ..> UC07 : <<extend>>
  UC06 ..> UC07 : <<extend>>

  ' Manajemen Undangan
  UC11 ..> UC14 : <<extend>>
  UC12 ..> UC14 : <<extend>>

  ' Pembayaran & Aktivasi
  UC16 ..> UC17 : <<include>>
  UC17 ..> UC18 : <<include>>
  UC18 ..> UC19 : <<include>>
  UC19 ..> UC20 : <<include>>

  ' Preview dari katalog
  UC02 ..> UC03 : <<extend>>

  ' Undangan Publik
  UC23 ..> UC24 : <<extend>>
  UC23 ..> UC25 : <<extend>>
  UC23 ..> UC26 : <<extend>>
  UC23 ..> UC27 : <<extend>>
}

' ============================================================
'  KONEKSI AKTOR — USE CASE
' ============================================================

' Pengunjung
Visitor -- UC01
Visitor -- UC02
Visitor -- UC04
Visitor -- UC05
Visitor -- UC06

' Pengguna Terdaftar
User -- UC09
User -- UC10
User -- UC11
User -- UC12
User -- UC13
User -- UC15
User -- UC16
User -- UC21
User -- UC22

' Tamu Undangan
Guest -- UC23
Guest -- UC24

' Mayar Payment Gateway
Mayar -- UC18
Mayar -- UC19

@enduml
